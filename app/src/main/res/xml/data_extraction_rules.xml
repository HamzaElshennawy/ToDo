<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks sync through Google Drive; Android's own cloud backup is left on for the database too. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
